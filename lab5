create table infs_krzeminskit.client as select * from company_2025.CLIENT;
create table infs_krzeminskit.order as select * from company_2025.ORDER;
create table infs_krzeminskit.employee as select * from company_2025.EMPLOYEE;
select * from infs_krzeminskit.order;
select * from infs_krzeminskit.order
	where order_status=5;
select order_id, order_status from infs_krzeminskit.order
	where CLIENT_ID IN(1,3,5);
    

select * from employee
	where FIRST_NAME ='agnieszka'
		and pensja=3900;
select * from employee
	where pensja between 5000 and 7000;
select * from client 
	where SHORT_NAME like '%eco%' 
    and is_company = 1;
    
    
select * from infs_krzeminskit.order
	where order_date like '%-06-%' 
    or order_date like '%-07-%';
select * from client
	where TAX_IDENTIFIER is not null
    order by SHORT_NAME;
select * from employee
	order by BIRTH_DATE
    limit 5;


select distinct first_name from employee;
select concat(first_name,' ',last_name) from employee
	where last_name like 'ko%';
select last_name, pensja from employee 
	where DATE_OF_EMPLOYMENT between '2010-01-01' and '2014-12-31';
    
    
select pensja, pensja*0.75 as pensja_netto, pensja*0.25 as kwota_podatku from employee;
select * from client
	where TAX_IDENTIFIER is null;
select short_name from client
	where SHORT_NAME like 'K%'
    or SHORT_NAME like '%ski'
    order by SHORT_NAME desc;
